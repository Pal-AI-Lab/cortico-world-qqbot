{
  "tools": [
    {
      "name": "qqofficial_send_message",
      "description": "发一条 QQ 消息：文字，可以带一张图片(image),或者单独发一条语音(voice)。reply_to 填消息编号，回复那一条，会话随之确定;quote=true 时在 QQ 里显示引用。不填 reply_to 时按主动消息发送;delivery=auto 会自动挑选还能用的回复依据。",
      "parameters": {
        "type": "object",
        "properties": {
          "to": {
            "type": "string",
            "description": "c2c:<OpenID>, group:<group OpenID>, channel:<id> or dms:<id>"
          },
          "reply_to": {
            "type": "string",
            "description": "#<n> from the start of a message line"
          },
          "eventId": {
            "type": "string"
          },
          "delivery": {
            "type": "string",
            "enum": [
              "auto",
              "reply",
              "proactive",
              "wakeup"
            ]
          },
          "fallback": {
            "type": "boolean"
          },
          "text": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "voice": {
            "type": "string"
          },
          "quote": {
            "type": "boolean"
          },
          "format": {
            "type": "string",
            "enum": [
              "text",
              "markdown"
            ]
          },
          "keyboard": {
            "type": "object"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "tags": [
        "speak"
      ],
      "summary": {
        "zh": "发送文字，可带一张图片或单独一条语音。",
        "en": "Sends text, optionally with one image, or a voice bar."
      }
    },
    {
      "name": "qqofficial_send_media",
      "description": "发视频、文件，或一次发多张图片(items,最多 8 项)。url 与 blob(log:/mem: 句柄)二选一;fileType:1 图片、2 视频、3 语音、4 文件。部分失败时已发出的不会重发。",
      "parameters": {
        "type": "object",
        "properties": {
          "to": {
            "type": "string",
            "description": "c2c:<OpenID>, group:<group OpenID>, channel:<id> or dms:<id>"
          },
          "reply_to": {
            "type": "string",
            "description": "#<n> from the start of a message line"
          },
          "eventId": {
            "type": "string"
          },
          "delivery": {
            "type": "string",
            "enum": [
              "auto",
              "reply",
              "proactive",
              "wakeup"
            ]
          },
          "fallback": {
            "type": "boolean"
          },
          "url": {
            "type": "string"
          },
          "blob": {
            "type": "string"
          },
          "fileType": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "fileName": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "url": {
                  "type": "string"
                },
                "blob": {
                  "type": "string"
                },
                "fileType": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4
                },
                "fileName": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "fileType"
              ]
            }
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "tags": [
        "speak"
      ],
      "summary": {
        "zh": "发送视频、文件或多张图片。",
        "en": "Sends video, files or several images."
      }
    },
    {
      "name": "qqofficial_stream_message",
      "description": "followModel=true:下一轮你写的公开正文会自动发到这个会话，私聊里逐字显示，其他会话在本轮结束后整段发出。手动分片时传 text,续片沿用返回的 streamId,finish 默认 true。",
      "parameters": {
        "type": "object",
        "properties": {
          "to": {
            "type": "string",
            "description": "c2c:<OpenID>, group:<group OpenID>, channel:<id> or dms:<id>"
          },
          "reply_to": {
            "type": "string",
            "description": "#<n> from the start of a message line"
          },
          "eventId": {
            "type": "string"
          },
          "delivery": {
            "type": "string",
            "enum": [
              "auto",
              "reply",
              "proactive",
              "wakeup"
            ]
          },
          "fallback": {
            "type": "boolean"
          },
          "text": {
            "type": "string"
          },
          "format": {
            "type": "string",
            "enum": [
              "text",
              "markdown"
            ]
          },
          "streamId": {
            "type": "string"
          },
          "finish": {
            "type": "boolean"
          },
          "followModel": {
            "type": "boolean"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "tags": [
        "speak"
      ],
      "summary": {
        "zh": "发送流式分片或自动转发下一轮回复正文。",
        "en": "Sends stream parts or forwards the next public reply."
      }
    },
    {
      "name": "qqofficial_delete_message",
      "description": "撤回你发过的一条消息，填它的编号。",
      "parameters": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "#<n> from the start of a message line"
          }
        },
        "required": [
          "message"
        ],
        "additionalProperties": false
      },
      "tags": [
        "act"
      ],
      "summary": {
        "zh": "撤回机器人发送的消息。",
        "en": "Recalls messages sent by the bot."
      }
    },
    {
      "name": "qqofficial_read_history",
      "description": "读 QQ 会话的历史消息，可按会话(to)筛选，before 填编号往前翻。",
      "parameters": {
        "type": "object",
        "properties": {
          "to": {
            "type": "string",
            "description": "c2c:<OpenID>, group:<group OpenID>, channel:<id> or dms:<id>"
          },
          "before": {
            "type": "string",
            "description": "#<n> from the start of a message line"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "tags": [
        "read"
      ],
      "summary": {
        "zh": "读取 QQ 会话的历史消息。",
        "en": "Reads past QQ messages."
      }
    },
    {
      "name": "qqofficial_read_attachment",
      "description": "读取一条消息里的附件(语音转成 WAV)。message 填消息编号;index 是第几个附件，默认第 1 个;quoted=true 读它引用的那条消息里的附件。",
      "parameters": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "#<n> from the start of a message line"
          },
          "index": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "quoted": {
            "type": "boolean"
          }
        },
        "required": [
          "message"
        ],
        "additionalProperties": false
      },
      "tags": [
        "read"
      ],
      "summary": {
        "zh": "读取已保存消息的 QQ CDN 附件。",
        "en": "Reads QQ CDN attachments from stored messages."
      }
    },
    {
      "name": "qqofficial_list_targets",
      "description": "列出认识的 QQ 会话、地址，以及现在还能不能被动回复。定时提醒里记下准确地址，到点后用 delivery=proactive 发送。",
      "parameters": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "tags": [
        "read"
      ],
      "summary": {
        "zh": "查询已知 QQ 会话及主动接收状态。",
        "en": "Lists known QQ targets and proactive reception state."
      }
    },
    {
      "name": "qqofficial_ack_interaction",
      "description": "确认按钮互动:code=0 成功、1 失败、2 太频繁、3 重复、4 无权限、5 仅管理员可操作。",
      "parameters": {
        "type": "object",
        "properties": {
          "interactionId": {
            "type": "string"
          },
          "code": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          }
        },
        "required": [
          "interactionId",
          "code"
        ],
        "additionalProperties": false
      },
      "tags": [
        "act"
      ],
      "summary": {
        "zh": "确认平台互动事件。",
        "en": "Acknowledges platform interactions."
      }
    }
  ],
  "events": [
    {
      "type": "qqofficial.message",
      "trigger": "debounce",
      "description": {
        "zh": "收到一条 QQ 消息，渲染成一行可读文本，原始字段留在存档里。",
        "en": "An incoming QQ message rendered as one readable line; original fields stay in the archive."
      }
    },
    {
      "type": "qqofficial.notice",
      "trigger": "debounce",
      "description": {
        "zh": "收到互动、关系变化或其他平台事件。",
        "en": "An interaction, relationship change or other platform event."
      }
    },
    {
      "type": "qqofficial.sent",
      "tags": [
        "speak"
      ],
      "description": {
        "zh": "平台接受发送请求的存档回执，不唤醒模型。",
        "en": "An archived send receipt; does not wake the model."
      }
    },
    {
      "type": "qqofficial.attempt",
      "description": {
        "zh": "发送前持久化的序号预留，不唤醒模型。",
        "en": "A sequence reservation persisted before sending; does not wake the model."
      }
    },
    {
      "type": "qqofficial.removed",
      "description": {
        "zh": "平台接受撤回请求的存档回执，不唤醒模型。",
        "en": "An archived recall receipt; does not wake the model."
      }
    },
    {
      "type": "qqofficial.acknowledged",
      "description": {
        "zh": "平台接受互动确认的存档回执，不唤醒模型。",
        "en": "An archived interaction acknowledgement; does not wake the model."
      }
    }
  ],
  "prompts": [
    {
      "key": "worlds.qqofficial.envPrompt",
      "title": "环境提示词",
      "role": "envPrompt",
      "content": "{{qqofficial.environment}}\n\n{{qqofficial.conversations}}\n{{qqofficial.identity}}\n"
    }
  ]
}
